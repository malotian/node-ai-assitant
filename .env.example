APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# 64 character random string to encrypt the session cookie
#
# We're generating a secret for your convenience, but for production,
# generate your own secret using `openssl rand -hex 32`
AUTH0_SECRET=XXXXXXXXXXXXXXXXXXXXX

# Optional: Auth0 API identifier for a first-party API registered in Auth0 (Applications -> APIs).
# Leave unset to use the access token for /userinfo only.
# AUTH0_API_AUDIENCE=https://your-api.example.com

LLM_API_KEY=XXXXXXXXXXXXXXXXXXXXX
LLM_MODEL="gemini-latest-flash"

# Server log level: error | warn | info | debug
LOG_LEVEL=info
# Auth0 library internals (state/nonce checks, code exchange, refresh)
# DEBUG=express-openid-connect


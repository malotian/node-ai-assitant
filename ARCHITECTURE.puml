@startuml Express_AI_Assistant_Architecture
!theme plain
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial

title Express AI Assistant - System Architecture\n(Node.js + Express + LangGraph + Gemini)

package "🌐 CLIENT LAYER (Browser)" {
    [index.html\nEntry Point] as HTML
    [js/auth.js\nAuth State Manager] as AuthUI
    [js/chat.js\nChat Interface] as ChatUI
    [style.css\nTheme & Layout] as Style
    [EventSource\nSSE Listener] as EventListener
}

package "⚙️ SERVER LAYER (Node.js/Express)" {
    [src/server.js\nExpress Router] as Server
    [express-openid-connect\nOIDC Middleware] as OIDC
    [express-session\nSession Store] as SessionStore
    [src/logger.js\nWinston Logger] as Logger
}

package "🤖 AI LAYER (Agent & Tools)" {
    [src/agent.js\nLangGraph Graph] as Agent
    [State Management\n(messages, config)] as AgentState
    [LLM Node] as LLMNode
    [Tool Node] as ToolNode
    [get_current_time\n(Public)] as ToolPublic
    [get_user_profile\n(Protected)] as ToolProtected
    [requestLogin\n(Signal)] as ToolLogin
    [MemorySaver\nCheckpointer] as Memory
    [Dict Store] as MemStore
    [ChatGoogleGenerativeAI] as LLMClient
}

package "🔐 AUTH LAYER (Security)" {
    [isAuthRequiredSignal()\nMessage Parser] as SignalDetector
}

cloud "☁️ EXTERNAL SERVICES" {
    [Auth0\nOIDC Provider] as Auth0
    [Google Gemini API] as GeminiAPI
}

' === INTERNAL STRUCTURE ===
HTML ..> AuthUI : import
HTML ..> ChatUI : import
HTML ..> Style : load
ChatUI ..> EventListener : use

Server --> OIDC : use middleware
Server --> SessionStore : track sessions
Server --> Logger : log activity

Agent --> AgentState : read/write state
Agent --> LLMNode : invoke
Agent --> ToolNode : invoke
LLMNode --> LLMClient : prompt
LLMClient <--> GeminiAPI : generateContent

ToolNode --> ToolPublic : route
ToolNode --> ToolProtected : route
ToolNode --> ToolLogin : route

Agent --> Memory : save state
Memory --> MemStore : persist

' === CROSS-LAYER CONNECTIONS ===
ChatUI --> Server : POST /api/chat
Server --> Agent : invoke(messages, config)
Agent --> SignalDetector : messages[]
SignalDetector --> Server : TRUE/FALSE

Server --> EventListener : SSE stream

AuthUI --> Server : GET /api/auth/status\nGET /api/me
HTML --> Server : GET /auth/login\nGET /auth/logout

OIDC <--> Auth0 : OAuth 2.0 / OIDC

@enduml

@startuml Definitive_Auth_Signal_Sequence
!theme plain
autonumber
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam lifelineStrategy solid

title Express AI Assistant - Signal-Based Auth & Chat Flow

actor User as user
participant "Browser\n(chat.js)" as ui
participant "Express Server\n(server.js)" as server
participant "LangGraph\nAgent" as agent
participant "Tool\nExecutor" as tools
participant "Gemini API" as llm
participant "Auth0" as auth0

rect rgb(200, 220, 255)
== 1️⃣ PUBLIC TOOL (Anonymous User) ==
user -> ui : "What time is it in Tokyo?"
ui -> server : POST /api/chat\n{ message, threadId }
note over server
  config: {
    authenticated: false,
    user: null
  }
end note

server -> agent : invoke(messages, config)
agent -> llm : Prompt:\n"What time is it in Tokyo?"
llm --> agent : FunctionCall:\nget_current_time\n({ timezone: "Asia/Tokyo" })

agent -> tools : execute(get_current_time, { ... })
tools --> agent : ToolMessage:\n"4:57 AM JST"

agent -> llm : Tool result: "4:57 AM JST"
llm --> agent : AIMessage:\n"It's 4:57 AM in Tokyo."

agent --> server : result {\n  messages: [\n    UserMessage,\n    FunctionCall ToolMessage,\n    AIMessage\n  ]\n}

server -> server : CHECK: isAuthRequiredSignal()\n→ Scans ToolMessage.content\n→ requiresAuth flag? NO\n→ Return: FALSE
note over server #c8f0c8
  No requiresAuth flag found
  in any ToolMessage → safe to stream
end note

server -> ui : SSE:\ntoken: "It's"
server -> ui : SSE:\ntoken: " 4:57"
server -> ui : SSE:\ntoken: " AM in Tokyo."
server -> ui : SSE:\ndone: true

ui -> ui : Render tokens\nNo login button appended
ui -> user : Displays answer
end rect

rect rgb(255, 220, 200)
== 2️⃣ PROTECTED TOOL (Anonymous → Definitive Signal) ==
user -> ui : "Who am I?"
ui -> server : POST /api/chat\n{ message, threadId }
note over server
  config: {
    authenticated: false,
    user: null
  }
end note

server -> agent : invoke(messages, config)
agent -> llm : Prompt:\n"Who am I?"
llm --> agent : FunctionCall:\nget_user_profile()

agent -> tools : execute(get_user_profile, config)
note over tools #ffcccc
  ⚠️ DEFINITIVE SIGNAL:
  Requested tool requires auth.
  authenticated flag = false
  → Reject with requiresAuth signal
end note
tools --> agent : ToolMessage:\n{\n  requiresAuth: true,\n  error: "AUTH_REQUIRED",\n  content: "User must authenticate"\n}

agent -> llm : Tool returned error:\n"User must authenticate"
llm --> agent : AIMessage:\n"You need to log in\nto see your profile."

agent --> server : result {\n  messages: [\n    UserMessage,\n    FunctionCall ToolMessage,\n    ToolMessage { requiresAuth: true },\n    AIMessage\n  ]\n}

server -> server : CHECK: isAuthRequiredSignal()\n→ Scans ALL ToolMessage items\n→ Find requiresAuth: true?\n→ YES!\n→ Return: TRUE
note over server #ffcccc
  Definitive: ToolMessage explicitly
  declares auth required
  (ignores LLM text content)
end note

server -> ui : SSE:\ntoken: "You need"
server -> ui : SSE:\ntoken: " to log in"
server -> ui : SSE:\ntoken: " to see your profile."
server -> ui : SSE event:\nrequireAuth: true
server -> ui : SSE:\ndone: true

ui -> ui : ReceiveMessage handler:\nif event.requireAuth === true:\n  showLoginPrompt()
ui -> user : Displays explanation\n+ [🔐 Log in] button
end rect

rect rgb(200, 255, 200)
== 3️⃣ AUTHENTICATION (OAuth 2.0 Flow) ==
user -> ui : Clicks [🔐 Log in]
ui -> server : GET /auth/login
note over server
  express-openid-connect
  middleware triggers redirect
end note
server -> auth0 : Redirect to:\n/authorize?...\n(client_id, redirect_uri, state)

auth0 -> user : Shows login form
user -> auth0 : Enters credentials\n(email, password)
note over auth0
  Auth0 validates credentials
  Issues authorization code
end note
auth0 -> server : Redirects to:\n/auth/callback?code=...

note over server
  OIDC middleware:
  1. Exchange code for tokens
  2. Validate JWT (id_token)
  3. Extract claims (name, email, sub)
  4. Create session cookie
  5. Store in session store
end note
server -> server : Issues HTTP-only\nSecure session cookie

server -> ui : 302 Redirect → /
ui -> server : GET /
server -> ui : 200 + index.html

ui -> server : GET /api/auth/status
server --> ui : { authenticated: true }

ui -> server : GET /api/me
server --> ui : {\n  name: "Alice",\n  email: "alice@example.com",\n  sub: "auth0|...",\n  ...claims\n}

ui -> ui : Update header:\n"Alice" profile\nShow logout button
ui -> user : "Welcome back, Alice!"
end rect

rect rgb(220, 200, 255)
== 4️⃣ AUTHENTICATED FLOW (Protected Tool Success) ==
user -> ui : "Who am I?" (again)
ui -> server : POST /api/chat\n{ message, threadId }\n+ session cookie
note over server
  express-openid-connect middleware
  validates session cookie
  Extracts claims from session
end note

note over server
  config: {
    authenticated: true,
    user: {
      name: "Alice",
      email: "alice@example.com",
      ...
    }
  }
end note

server -> agent : invoke(messages, config)
agent -> llm : Prompt with context:\n"User is Alice (alice@example.com)\nQuestion: Who am I?"

llm --> agent : FunctionCall:\nget_user_profile()

agent -> tools : execute(get_user_profile, config)
note over tools #c8f0c8
  ✓ ALLOW: authenticated = true
  Return user data from config
end note
tools --> agent : ToolMessage:\n{\n  name: "Alice",\n  email: "alice@example.com"\n}

agent -> llm : Tool returned:\nAlice's profile data

llm --> agent : AIMessage:\n"You are Alice\n(alice@example.com)."

agent --> server : result {\n  messages: [\n    UserMessage,\n    FunctionCall ToolMessage,\n    ToolMessage { name, email },\n    AIMessage\n  ]\n}

server -> server : CHECK: isAuthRequiredSignal()\n→ Scans ToolMessage items\n→ requiresAuth: true?\n→ NO\n→ Return: FALSE
note over server #c8f0c8
  No auth signal detected
  Stream response normally
end note

server -> ui : SSE:\ntoken: "You are"
server -> ui : SSE:\ntoken: " Alice"
server -> ui : SSE:\ntoken: " (alice@example.com)."
server -> ui : SSE:\ndone: true

ui -> ui : Render tokens\nNo login button
ui -> user : "You are Alice (alice@example.com)."
end rect

@enduml

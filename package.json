{
  "name": "express-ai-assistant",
  "version": "1.0.0",
  "description": "AI assistant: Express + Auth0 Universal Login + LangGraph agent (Gemini)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "stop": "fuser -k 3000/tcp 2>/dev/null || true; pkill -f '[n]ode.*src/server.js' 2>/dev/null || true",
    "test": "node --test test/auth-signal.test.js test/chat-ui.test.js",
    "test:all": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.1.1",
    "@langchain/core": "^1.2.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.21",
    "axios": "^1.6.5",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "express-jwt": "^8.4.1",
    "jwks-rsa": "^3.1.0",
    "langchain": "^1.5.15",
    "winston": "^3.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  }
}

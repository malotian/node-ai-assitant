@startuml Error_Handling_Tool_Exception
!theme plain
autonumber
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam lifelineStrategy solid

title Sequence: Error Handling - Tool Failure vs. Agent Failure

actor User
participant "Browser\n(chat.js)" as UI
participant "Express Server\n(server.js)" as Server
participant "LangGraph Agent" as Agent
participant "Tool Executor" as Tools
participant "Auth0\n/userinfo" as Auth0
participant "Gemini API" as LLM

== Tool failure: the LLM explains it ==

User -> UI : "Who am I?" (logged in)
UI -> Server : POST /api/chat + session cookie
Server -> Agent : invoke(messages, config { authenticated: true })
activate Agent

Agent -> LLM : Prompt: "Who am I?"
LLM --> Agent : FunctionCall: get_user_profile()

Agent -> Tools : execute(get_user_profile)
activate Tools
Tools -> Auth0 : GET /userinfo (Bearer token)
Auth0 --> Tools : 500 / network error
note over Tools #ffebee
  Non-401 failure: returned as text,
  NOT as an auth-required payload
end note
Tools --> Agent : ToolMessage: "Failed to fetch user profile: HTTP 500"
deactivate Tools

Agent -> LLM : Tool result
LLM --> Agent : AIMessage: "Sorry, I couldn't load your profile right now."
deactivate Agent
Agent --> Server : result { messages }

Server -> Server : isAuthRequiredSignal(messages) → FALSE
note over Server #c8f0c8
  Tool error ≠ auth signal
end note
Server -> UI : SSE { token: "Sorry, I couldn't load your profile right now." }
Server -> UI : SSE { done: true }
UI -> User : Reply, no login button

== Agent failure (e.g. Gemini unreachable / bad API key) ==

User -> UI : any message
UI -> Server : POST /api/chat
Server -> Agent : invoke(...)
Agent -> LLM : Prompt
LLM --> Agent : error
Agent --> Server : throws
Server -> UI : SSE { error: "<message>" }
UI -> User : "⚠️ <message>"

@enduml

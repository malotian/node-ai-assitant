@startuml Error_Handling_Tool_Exception
!theme plain
autonumber
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam lifelineStrategy solid

title Sequence: Error Handling - Tool Exception

actor User
participant "Browser\n(chat.js)" as UI
participant "Express Server\n(server.js)" as Server
participant "LangGraph Agent" as Agent
participant "Tool Executor" as Tools
participant "Gemini API" as LLM

User -> UI : "Get current weather"
UI -> Server : POST /api/chat\n{ message, threadId }
note over Server
  config: { authenticated: false }
end note

Server -> Agent : invoke(messages, config)
activate Agent

Agent -> LLM : Prompt: "Get current weather"
activate LLM
LLM --> Agent : FunctionCall: get_weather({ location: "..." })
deactivate LLM

Agent -> Tools : execute(get_weather, {...})
activate Tools
note over Tools #ffebee
  ⚠️ TOOL EXCEPTION
  Weather API timeout
  Tool throws error
end note
Tools --> Agent : ToolMessage: {\n  error: "WEATHER_API_ERROR",\n  message: "Failed to fetch weather data"\n}
deactivate Tools

Agent -> LLM : Tool error: "Failed to fetch weather data"
activate LLM
LLM --> Agent : AIMessage: "Sorry, I couldn't fetch the weather right now. Try again later."
deactivate LLM

deactivate Agent
Agent --> Server : result {\n  messages: [\n    UserMessage,\n    FunctionCall,\n    ToolMessage { error },\n    AIMessage\n  ]\n}

Server -> Server : isAuthRequiredSignal(messages)\n→ requiresAuth: true? NO\n→ Return: FALSE
note over Server #c8f0c8
  Tool error ≠ auth signal
  Safe to stream error message
end note

Server -> UI : SSE event: { token: "Sorry" }
Server -> UI : SSE event: { token: "..." }
Server -> UI : SSE event: { done: true }

UI -> User : Error message from LLM

@enduml

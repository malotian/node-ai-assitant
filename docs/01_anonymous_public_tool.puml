@startuml Anonymous_Public_Tool
!theme plain
autonumber
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam lifelineStrategy solid

title Sequence: Anonymous User - Public Tool (get_current_time)

actor User
participant "Browser\n(chat.js)" as UI
participant "Express Server\n(server.js)" as Server
participant "LangGraph Agent" as Agent
participant "Tool Executor" as Tools
participant "Gemini API" as LLM

User -> UI : "What time is it in Tokyo?"
UI -> Server : POST /api/chat\n{ message, threadId }
note over Server #e3f2fd
  No session cookie
  config: { authenticated: false, user: null }
end note

Server -> Agent : invoke(messages, config)
activate Agent

Agent -> LLM : Prompt: "What time is it in Tokyo?"
activate LLM
LLM --> Agent : FunctionCall: get_current_time({ timezone: "Asia/Tokyo" })
deactivate LLM

Agent -> Tools : execute(get_current_time)
activate Tools
Tools --> Agent : ToolMessage: "04:57 AM JST"
deactivate Tools

Agent -> LLM : Tool result: "04:57 AM JST"
activate LLM
LLM --> Agent : AIMessage: "It's 4:57 AM in Tokyo right now."
deactivate LLM

deactivate Agent
Agent --> Server : result {\n  messages: [\n    UserMessage,\n    FunctionCall,\n    ToolMessage,\n    AIMessage\n  ]\n}

Server -> Server : isAuthRequiredSignal(messages)\n→ requiresAuth flag found? NO\n→ Return: FALSE
note over Server #c8f0c8
  Safe to stream response
  No login required
end note

loop Token streaming (SSE)
  Server -> UI : SSE event: { token: "It's" }
  Server -> UI : SSE event: { token: " 4:57" }
  Server -> UI : SSE event: { token: " AM..." }
end

Server -> UI : SSE event: { done: true }

UI -> UI : Render tokens\nNo login button
UI -> User : "It's 4:57 AM in Tokyo right now."

@enduml

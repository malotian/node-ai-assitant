@startuml Authenticated_Protected_Tool
!theme plain
autonumber
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam lifelineStrategy solid

title Sequence: Authenticated User - Protected Tool Success

actor User
participant "Browser\n(chat.js)" as UI
participant "Express Server\n(server.js)" as Server
participant "LangGraph Agent" as Agent
participant "Tool Executor" as Tools
participant "Gemini API" as LLM

User -> UI : "Who am I?" (after login)
UI -> Server : POST /api/chat\n{ message, threadId }\n+ session cookie
note over Server #c8f0c8
  express-openid-connect middleware:
  1. Validates session cookie
  2. Extracts claims from session
  3. Sets config.authenticated = true
end note

note over Server
  config: {
    authenticated: true,
    user: {
      name: "Alice",
      email: "alice@example.com",
      sub: "auth0|12345"
    }
  }
end note

Server -> Agent : invoke(messages, config)
activate Agent

Agent -> LLM : Prompt with context:\n"User is Alice (alice@example.com)\n\nQuestion: Who am I?"
activate LLM
LLM --> Agent : FunctionCall: get_user_profile()
deactivate LLM

Agent -> Tools : execute(get_user_profile, config)
activate Tools
note over Tools #c8f0c8
  ✓ ALLOW: authenticated = true
  Return user profile from config
end note
Tools --> Agent : ToolMessage: {\n  name: "Alice",\n  email: "alice@example.com",\n  sub: "auth0|12345"\n}
deactivate Tools

Agent -> LLM : Tool result: Alice's profile
activate LLM
LLM --> Agent : AIMessage: "You are Alice (alice@example.com)."
deactivate LLM

deactivate Agent
Agent --> Server : result {\n  messages: [\n    UserMessage,\n    FunctionCall,\n    ToolMessage { user data },\n    AIMessage\n  ]\n}

Server -> Server : isAuthRequiredSignal(messages)\n→ requiresAuth flag found? NO\n→ Return: FALSE
note over Server #c8f0c8
  No auth signal detected
  Stream response safely
end note

loop Token streaming (SSE)
  Server -> UI : SSE event: { token: "You are" }
  Server -> UI : SSE event: { token: " Alice" }
end

Server -> UI : SSE event: { done: true }

UI -> UI : Render tokens\nNo login button appended
UI -> User : "You are Alice (alice@example.com)."

@enduml

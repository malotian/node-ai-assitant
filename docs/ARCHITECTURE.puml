@startuml Express_AI_Assistant_Architecture
!theme plain
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial

title Express AI Assistant - System Architecture\n(Node.js + Express + LangGraph + Gemini)

package "CLIENT (Browser)" {
    [index.html\nSingle chat page] as HTML
    [js/auth.js\nAuth state] as AuthUI
    [js/chat.js\nChat + SSE reader] as ChatUI
    [style.css] as Style
    [localStorage\nthreadId, threadOwner, history] as LocalStore
}

package "SERVER (src/)" {
    [server.js\nExpress routes + SSE] as Server
    [express-openid-connect\nOIDC middleware\n(encrypted session cookie)] as OIDC
    [logger.js\nWinston] as Logger
    [observability.js\nAgent callbacks] as Obs
}

package "AI (src/)" {
    [agent.js\ncreateAgent] as Agent
    [MemorySaver\nconversation memory] as Memory
    [ChatGoogleGenerativeAI] as LLMClient
    [get_current_time\n(public)] as ToolTime
    [get_user_profile\n(auth required)] as ToolProfile
    [request_login\n(login intent)] as ToolLogin
    [isAuthRequiredSignal()\n(tools.js)] as SignalDetector
}

cloud "EXTERNAL" {
    [Auth0\nUniversal Login + /userinfo] as Auth0
    [Google Gemini API] as GeminiAPI
}

HTML ..> AuthUI : loads
HTML ..> ChatUI : loads
HTML ..> Style : loads
ChatUI --> LocalStore

ChatUI --> Server : POST /api/chat (SSE)
AuthUI --> Server : GET /api/auth/status\nGET /api/me
HTML --> Server : GET /auth/login\nGET /auth/logout

Server --> OIDC : session & access token
OIDC <--> Auth0 : OIDC Authorization Code\n(+ refresh token)
Server --> Logger
Obs --> Logger

Server --> Agent : invoke(messages, configurable)
Agent ..> Obs : callbacks
Agent --> Memory : thread_id = sub:threadId
Agent --> LLMClient
LLMClient <--> GeminiAPI : function calling
Agent --> ToolTime
Agent --> ToolProfile
Agent --> ToolLogin
ToolProfile --> Auth0 : GET /userinfo\nBearer <user access token>
Server --> SignalDetector : ToolMessages of current turn

@enduml
